# Domain pointing to this machine. No domain? Use sslip.io: for IP 129.1.2.3 → 129-1-2-3.sslip.io
SERVER_DOMAIN=129-1-2-3.sslip.io

# Same Postgres used by the website (Neon/Supabase connection string)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Must be identical to REALTIME_SECRET on Vercel
REALTIME_SECRET=troque-por-um-segredo-longo

# Website address(es) allowed to call this server (comma separated)
WEB_ORIGIN=https://seu-projeto.vercel.app
