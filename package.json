{
  "name": "texcollab",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@texcollab/server & npm run dev --workspace=@texcollab/web",
    "build": "npm run build --workspace=@texcollab/web",
    "db:generate": "npm run generate --workspace=@texcollab/db",
    "db:migrate": "npm run migrate --workspace=@texcollab/db",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
