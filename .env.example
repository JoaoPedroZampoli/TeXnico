# ---------- Local development (npm run dev) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/texcollab

# Random secrets — generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
REALTIME_SECRET=

# Public URL of the website and of the realtime/compile server
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Optional social login (leave empty to hide the buttons)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- docker compose (docker-compose.yml) ----------
# PUBLIC_WEB_URL=http://localhost:3000
# PUBLIC_REALTIME_URL=http://localhost:4000
# POSTGRES_PASSWORD=texcollab

# ---------- Optional server tuning ----------
# COMPILE_TIMEOUT_SECONDS=90
# MAX_CONCURRENT_COMPILES=2
# MAX_UPLOAD_MB=15
